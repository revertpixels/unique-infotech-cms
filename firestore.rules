rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function authEmail() {
      return request.auth.token.email.lower();
    }
    function provider() {
      return request.auth.token.firebase.sign_in_provider;
    }

    // Super Admin: ONE locked identity, email+password sign-in only
    function isSuperAdmin() {
      // TEMPORARY (development only): Super Admin login = haranathsaha1@gmail.com
      // BEFORE DELIVERY: change this back to 'utpal.goutam@gmail.com' (client's account).
      // Super Admin must sign in with email + password only (provider 'password').
      // NOTE FOR AGENTS: this is the ONLY place the Super Admin login email is set.
      // Do NOT change 'utpal.goutam@gmail.com' in receipts / org details / PDFs -
      // that is the business contact email printed on receipts, not a login.
      return signedIn()
        && provider() == 'password'
        && authEmail() == 'haranathsaha1@gmail.com';
    }

    // Heads: Google sign-in only, verified email
    function isGoogleVerified() {
      return signedIn()
        && provider() == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(authEmail());
    }
    function hasUserDoc() {
      return isGoogleVerified() && exists(userPath());
    }
    function me() {
      return get(userPath()).data;
    }
    function isActiveHead() {
      return hasUserDoc() && me().status == 'active';
    }
    function isBranchHead() {
      return isActiveHead() && me().role == 'branch_head';
    }
    function isSchoolHead() {
      return isActiveHead() && me().role == 'school_head';
    }
    function myBranchId() {
      return me().branchId;
    }

    // During Master Delete or Restore, block all client writes so live
    // snapshots/restores cannot mix with concurrent edits. Never auto-expires:
    // an interrupted destructive operation remains locked until recovery completes.
    function maintenanceOpen() {
      return !exists(/databases/$(database)/documents/_system/maintenance)
        || get(/databases/$(database)/documents/_system/maintenance).data.active != true;
    }

    // Hide business reads while Clear or Restore is replacing records so users
    // never observe a partial state. Backups keep reads open.
    function readsOpen() {
      return !exists(/databases/$(database)/documents/_system/maintenance)
        || get(/databases/$(database)/documents/_system/maintenance).data.active != true
        || get(/databases/$(database)/documents/_system/maintenance).data.mode == 'backup';
    }

    // Public-to-signed-in client state for dataset generation / maintenance banner.
    // _system/maintenance, _system_backup_manifests/*, and _system_backup_operations/*
    // stay strictly server-only (denied by catch-all rule below).
    match /_system/client_state {
      allow get: if signedIn();
      allow list, write: if false;
    }

    function validUserDoc(userEmail) {
      let d = request.resource.data;
      return userEmail == userEmail.lower()
        && d.email == userEmail
        && d.keys().hasOnly(['email', 'name', 'designation', 'phone', 'role', 'branchId', 'photoUrl', 'status', 'createdAt', 'createdBy', 'updatedAt'])
        && d.keys().hasAll(['email', 'role', 'status'])
        && (
             (d.role in ['branch_head', 'school_head'] && (d.role == 'school_head' || (d.branchId is string && d.branchId.size() > 0)))
             || (d.role == 'superadmin' && userEmail == authEmail())
           )
        && d.status in ['active', 'inactive']
        && (!('name' in d) || d.name == null || (d.name is string && d.name.size() <= 80))
        && (!('designation' in d) || d.designation == null || (d.designation is string && d.designation.size() <= 80))
        && (!('photoUrl' in d) || d.photoUrl == null || (d.photoUrl is string && d.photoUrl.size() <= 1024));
    }

    function isSelfPhotoOnlyUpdate(userEmail) {
      let d = request.resource.data;
      return isActiveHead()
        && userEmail == authEmail()
        && d.diff(resource.data).affectedKeys().hasOnly(['photoUrl', 'updatedAt'])
        && (!('photoUrl' in d) || d.photoUrl == null || (d.photoUrl is string && (d.photoUrl == '' || d.photoUrl.matches('https://.*')) && d.photoUrl.size() <= 1024));
    }

    function validBatchDoc() {
      let d = request.resource.data;
      return (d.allCourses == null || d.allCourses is bool)
        && (d.courseIds == null || (d.courseIds is list && d.courseIds.size() <= 100));
    }

    function validStudentDoc() {
      let d = request.resource.data;
      return d.ctx in ['youth', 'school']
        && (d.studentId is string && d.studentId.size() == 8)
        && (d.status is string && d.status.size() > 0)
        && (d.branchId is string && d.branchId.size() > 0)
        && (d.receiptNo == null || d.receiptNo is string);
    }

    match /users/{userEmail} {
      // Allow get even during maintenance so session resolution & recovery always work.
      allow get: if isSuperAdmin()
                 || (isGoogleVerified() && userEmail == authEmail())
                 || (readsOpen() && isActiveHead());
      allow list: if readsOpen() && (isSuperAdmin() || isActiveHead());
      allow create: if maintenanceOpen() && isSuperAdmin() && validUserDoc(userEmail);
      allow update: if maintenanceOpen() && (
                      (isSuperAdmin() && validUserDoc(userEmail))
                      || isSelfPhotoOnlyUpdate(userEmail)
                    );
      allow delete: if maintenanceOpen() && isSuperAdmin() && userEmail != authEmail();
    }

    match /settings/{docId} {
      allow read: if readsOpen() && (isSuperAdmin() || isActiveHead());
      allow write: if maintenanceOpen() && isSuperAdmin();
    }

    match /branches/{branchId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || (isBranchHead() && branchId == myBranchId())
        || (isActiveHead() && branchId == myBranchId()));
      allow write: if maintenanceOpen() && isSuperAdmin();
    }

    match /courses/{courseId} {
      allow read: if readsOpen() && (isSuperAdmin() || isBranchHead() || (isSchoolHead() && resource.data.ctx == 'school'));
      allow write: if maintenanceOpen() && isSuperAdmin();
    }

    match /batches/{batchId} {
      allow read: if readsOpen() && (isSuperAdmin() || isBranchHead() || (isSchoolHead() && resource.data.ctx == 'school'));
      allow create: if maintenanceOpen() && (isSuperAdmin()
        || (isBranchHead()
            && request.resource.data.branchId == myBranchId()
            && request.resource.data.ctx == 'youth'))
        && validBatchDoc();
      allow update: if maintenanceOpen() && (isSuperAdmin()
        || (isBranchHead()
            && request.resource.data.branchId == myBranchId()
            && request.resource.data.ctx == 'youth'
            && resource.data.branchId == myBranchId()))
        && validBatchDoc();
      allow delete: if maintenanceOpen() && isSuperAdmin();
    }

    match /levels/{levelId} {
      allow read: if readsOpen() && (isSuperAdmin() || isSchoolHead());
      allow write: if maintenanceOpen() && isSuperAdmin();
    }

    function validSessionUpdate() {
      return !('examFeeCollection' in resource.data)
        || resource.data.examFeeCollection == null
        || !('started' in resource.data.examFeeCollection)
        || resource.data.examFeeCollection.started != true
        || (('examFeeCollection' in request.resource.data)
            && request.resource.data.examFeeCollection == resource.data.examFeeCollection);
    }

    match /sessions/{sessionId} {
      allow read: if readsOpen() && (isSuperAdmin() || isBranchHead() || (isSchoolHead() && resource.data.ctx == 'school'));
      allow create, delete: if maintenanceOpen() && isSuperAdmin();
      allow update: if maintenanceOpen() && isSuperAdmin() && validSessionUpdate();
    }

    match /students/{studentId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || (isBranchHead() && resource.data.branchId == myBranchId())
        || (isSchoolHead() && resource.data.ctx == 'school'));
      allow create: if maintenanceOpen() && (isSuperAdmin()
        || (isBranchHead() && request.resource.data.branchId == myBranchId()
            && request.resource.data.ctx == 'youth'))
        && validStudentDoc();
      allow update: if maintenanceOpen() && (isSuperAdmin()
        || (isBranchHead() && resource.data.branchId == myBranchId()
            && request.resource.data.branchId == resource.data.branchId
            && request.resource.data.studentId == resource.data.studentId))
        && validStudentDoc();
      allow delete: if maintenanceOpen() && isSuperAdmin();

      match /docs/{docId} {
        allow read: if readsOpen() && (isSuperAdmin()
          || (isBranchHead() && get(/databases/$(database)/documents/students/$(studentId)).data.branchId == myBranchId())
          || (isSchoolHead() && get(/databases/$(database)/documents/students/$(studentId)).data.ctx == 'school'));
        // getAfter: the parent student doc may be created in the SAME batch (new admission).
        allow write: if maintenanceOpen() && (isSuperAdmin()
          || (isBranchHead() && getAfter(/databases/$(database)/documents/students/$(studentId)).data.branchId == myBranchId()));
      }

      // Activity log: append-only. Nobody can edit entries; Super Admin can delete during student purge.
      match /activity/{activityId} {
        allow read: if readsOpen() && (isSuperAdmin()
          || (isBranchHead() && get(/databases/$(database)/documents/students/$(studentId)).data.branchId == myBranchId()));
        allow create: if maintenanceOpen() && (isSuperAdmin()
          || (isBranchHead() && (
              (exists(/databases/$(database)/documents/students/$(studentId)) && get(/databases/$(database)/documents/students/$(studentId)).data.branchId == myBranchId()) ||
              getAfter(/databases/$(database)/documents/students/$(studentId)).data.branchId == myBranchId()
          )));
        allow update: if false;
        allow delete: if maintenanceOpen() && isSuperAdmin();
      }
    }

    match /students/{studentId}/payment/{paymentId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || (isBranchHead() && get(/databases/$(database)/documents/students/$(studentId)).data.branchId == myBranchId())
        || (isSchoolHead() && get(/databases/$(database)/documents/students/$(studentId)).data.ctx == 'school'));
      allow create: if maintenanceOpen() && (isSuperAdmin()
        || (isBranchHead() && (
            (exists(/databases/$(database)/documents/students/$(studentId)) && get(/databases/$(database)/documents/students/$(studentId)).data.branchId == myBranchId()) ||
            getAfter(/databases/$(database)/documents/students/$(studentId)).data.branchId == myBranchId()
        )
        && request.resource.data.waived == false
        && request.resource.data.recordedBy == request.auth.token.email.lower()));
      allow update, delete: if maintenanceOpen() && isSuperAdmin();
    }

    // Collection-group read access for collectionGroup(db, 'payment') (Payment History)
    match /{path=**}/payment/{paymentId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || (isBranchHead() && (
            resource.data.recordedAtBranchId == myBranchId()
            || get(/databases/$(database)/documents/$(path)).data.branchId == myBranchId()
        ))
        || (isSchoolHead() && get(/databases/$(database)/documents/$(path)).data.ctx == 'school'));
    }

    match /students/{studentId}/aadhaar/{aadhaarId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || (isBranchHead() && get(/databases/$(database)/documents/students/$(studentId)).data.branchId == myBranchId()));
      allow write: if maintenanceOpen() && (isSuperAdmin()
        || (isBranchHead() && getAfter(/databases/$(database)/documents/students/$(studentId)).data.branchId == myBranchId()));
    }

    match /counters/{counterId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || (isBranchHead() && (counterId.matches('sid_.*') || counterId.matches('rcpt_.*'))));
      allow write: if maintenanceOpen() && (isSuperAdmin()
        || (isBranchHead() && (counterId.matches('sid_.*') || counterId.matches('rcpt_.*'))));
    }

    match /enrolments/{enrolmentId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || isSchoolHead()
        || (isBranchHead() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.branchId == myBranchId()));
      allow create, update, delete: if maintenanceOpen() && isSuperAdmin();
    }

    match /bills/{billId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || isSchoolHead()
        || (isBranchHead() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.branchId == myBranchId()));
      allow create, update, delete: if maintenanceOpen() && isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || isSchoolHead()
        || (isBranchHead() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.branchId == myBranchId()));
      allow create, update, delete: if maintenanceOpen() && isSuperAdmin();
    }

    match /waivers/{waiverId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || isSchoolHead()
        || (isBranchHead() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.branchId == myBranchId()));
      allow create, update, delete: if maintenanceOpen() && isSuperAdmin();
    }

    match /breaks/{breakId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || isSchoolHead()
        || (isBranchHead() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.branchId == myBranchId()));
      allow create, update, delete: if maintenanceOpen() && isSuperAdmin();
    }

    match /transfers/{transferId} {
      allow read: if readsOpen() && (isSuperAdmin()
        || (isBranchHead() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.branchId == myBranchId()));
      allow create, update, delete: if maintenanceOpen() && isSuperAdmin();
    }

    match /deletionLog/{logId} {
      allow read: if readsOpen() && isSuperAdmin();
      allow create: if maintenanceOpen() && isSuperAdmin();
      allow update, delete: if false;
    }

    // Everything else (including _system/maintenance, _system_backup_manifests,
    // _system_backup_operations) is denied to client reads and writes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
